#!/bin/bash
# Enforces the Conventional Commits format described in
# .claude/skills/conventional-commits/SKILL.md
set -euo pipefail

commit_msg_file="$1"

# First non-empty, non-comment line is the subject
subject=$(grep -vE '^\s*#' "$commit_msg_file" | grep -vE '^\s*$' | head -1 || true)

# Allow merge/revert commits auto-generated by git
if echo "$subject" | grep -qE '^(Merge |Revert ")'; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_./-]+\))?!?: .+'

if ! echo "$subject" | grep -qE "$pattern"; then
  cat >&2 <<EOF
Commit message does not follow Conventional Commits format.

  Expected: <type>(<scope>): <summary>
  Types:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert
  Example:  feat(greet): add farewell function

Your subject line:
  $subject

See .claude/skills/conventional-commits/SKILL.md for details.
EOF
  exit 1
fi
